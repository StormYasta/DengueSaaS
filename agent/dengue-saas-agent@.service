[Unit]
Description=DengueSaaS Raspberry Pi heartbeat (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/dengue-saas-agent/agent
ExecStart=/opt/dengue-saas-agent/agent/.venv/bin/python /opt/dengue-saas-agent/agent/station_agent.py
Restart=always
RestartSec=10
# O agente usa sudo -n apenas para operações explicitamente permitidas
# em /etc/sudoers.d/dengue-saas-agent. NoNewPrivileges=true impediria o sudo.

[Install]
WantedBy=multi-user.target
