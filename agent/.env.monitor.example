# Endereço do SaaS na rede interna. Sem GPS: coordenadas no painel.
SAAS_API_URL=http://10.22.0.24:8090/api
SAAS_AGENT_KEY=INSERIR_A_MESMA_STATION_API_KEY_DO_SERVIDOR

STATION_SLUG=E01
STATION_NAME=Estação 01
STATION_LOCATION=São José do Rio Preto - SP

# Se o coletor roda via systemd, defina SERVICE_NAME.
# Se roda diretamente por Python, configure COLLECTOR_PROCESS_MATCH
# com o nome exato do arquivo que aparecer no comando ps.
SERVICE_NAME=estacao-dengue.service
# COLLECTOR_PROCESS_MATCH=Estacao_dojot_mtls_sem_pressao.py
HEARTBEAT_INTERVAL_SECONDS=30
SAAS_TIMEOUT_SECONDS=10

# Opcional: configure SOMENTE um arquivo gerado pelo coletor existente.
SENSOR_CSV_FILE=/home/evandro/Desktop/dados_estacao_sem_pressao.csv
# SENSOR_JSON_FILE=/caminho/real/ultima_leitura.json
